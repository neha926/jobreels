// Prisma Schema for Free Job + Reels Platform
// Covers Section 27 of PRD: Users, Profiles, Companies, Jobs, Applications, Reels, Likes, Comments, Saves, Messages, Notifications, Reports, Interviews, Skills, Locations, Admins

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CANDIDATE
  EMPLOYER
  ADMIN
}

enum ApplicationStatus {
  APPLIED
  VIEWED
  SHORTLISTED
  INTERVIEW
  SELECTED
  REJECTED
}

enum JobType {
  FULL_TIME
  PART_TIME
  TEMPORARY
  CONTRACT
  INTERNSHIP
  WORK_FROM_HOME
}

enum ReportReason {
  MONEY_ASKING
  FAKE_JOB
  WRONG_SALARY
  FAKE_COMPANY
  WRONG_LOCATION
  HARASSMENT
  OTHER
}

enum ReportStatus {
  UNDER_REVIEW
  BANNED
  DISMISSED
}

model User {
  id              String            @id @default(uuid())
  mobile          String            @unique
  role            Role              @default(CANDIDATE)
  language        String            @default("en") // "en", "hi", "mr"
  isBlocked       Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  candidateProfile CandidateProfile?
  companyProfile   CompanyProfile?
  reels            Reel[]
  likes            Like[]
  comments         Comment[]
  saves            Save[]
  sentMessages     Message[]        @relation("SentMessages")
  notifications    Notification[]
  reportsFiled     Report[]         @relation("ReportsFiled")
}

model CandidateProfile {
  id                String       @id @default(uuid())
  userId            String       @unique
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName          String
  avatarUrl         String?
  location          String
  state             String       @default("Maharashtra")
  education         String       // "Below 10th", "10th", "12th", "ITI", "Diploma", "Graduate"
  workCategory      String
  experienceYears   String       // "Fresher", "0-1 Year", "1-3 Years", "3-5 Years", "5+ Years"
  expectedSalary    Int?
  preferredLocation String?
  resumePdfUrl      String?
  isVerified        Boolean      @default(true)

  skills            CandidateSkill[]
  applications      Application[]
}

model CompanyProfile {
  id              String        @id @default(uuid())
  userId          String        @unique
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName     String
  companyType     String
  logoUrl         String?
  location        String
  hrName          String
  hrPhone         String
  gstin           String?
  isVerified      Boolean       @default(false)
  verifiedAt      DateTime?

  jobs            Job[]
}

model Job {
  id              String         @id @default(uuid())
  companyId       String
  company         CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title           String
  category        String
  minSalary       Int
  maxSalary       Int
  salaryDisplay   String
  location        String
  workingHours    String
  vacancies       Int            @default(1)
  education       String
  experienceReq   String
  jobType         JobType        @default(FULL_TIME)
  description     String
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())

  applications    Application[]
  reels           Reel[]
  saves           Save[]
  reports         Report[]
}

model Reel {
  id              String         @id @default(uuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId           String?
  job             Job?           @relation(fields: [jobId], references: [id], onDelete: SetNull)
  type            String         // "candidate_skill" or "company_job"
  videoUrl        String
  thumbnailUrl    String
  caption         String
  likesCount      Int            @default(0)
  commentsCount   Int            @default(0)
  sharesCount     Int            @default(0)
  isApproved      Boolean        @default(true)
  createdAt       DateTime       @default(now())

  likes           Like[]
  comments        Comment[]
  reports         Report[]
}

model Application {
  id              String            @id @default(uuid())
  jobId           String
  job             Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateId     String
  candidate       CandidateProfile  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  status          ApplicationStatus @default(APPLIED)
  appliedAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  interview       Interview?
}

model Interview {
  id              String            @id @default(uuid())
  applicationId   String            @unique
  application     Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interviewDate   DateTime
  interviewTime   String
  type            String            @default("In-Person")
  address         String
  contactPerson   String
  contactPhone    String
  googleMapsQuery String
  createdAt       DateTime          @default(now())
}

model Message {
  id              String            @id @default(uuid())
  senderId        String
  sender          User              @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId     String
  conversationId  String
  messageText     String
  messageType     String            @default("text") // "text", "interview_card", "image", "doc"
  metaPayload     Json?
  createdAt       DateTime          @default(now())
}

model Report {
  id              String            @id @default(uuid())
  reportedById    String
  reportedBy      User              @relation("ReportsFiled", fields: [reportedById], references: [id], onDelete: Cascade)
  jobId           String?
  job             Job?              @relation(fields: [jobId], references: [id], onDelete: SetNull)
  reelId          String?
  reel            Reel?             @relation(fields: [reelId], references: [id], onDelete: SetNull)
  reason          ReportReason
  details         String
  status          ReportStatus      @default(UNDER_REVIEW)
  createdAt       DateTime          @default(now())
}

model CandidateSkill {
  id              String            @id @default(uuid())
  candidateId     String
  candidate       CandidateProfile  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  skillName       String
}

model Like {
  id              String            @id @default(uuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  reelId          String
  reel            Reel              @relation(fields: [reelId], references: [id], onDelete: Cascade)

  @@unique([userId, reelId])
}

model Comment {
  id              String            @id @default(uuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  reelId          String
  reel            Reel              @relation(fields: [reelId], references: [id], onDelete: Cascade)
  commentText     String
  createdAt       DateTime          @default(now())
}

model Save {
  id              String            @id @default(uuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId           String
  job             Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
}

model Notification {
  id              String            @id @default(uuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  body            String
  isRead          Boolean           @default(false)
  createdAt       DateTime          @default(now())
}
